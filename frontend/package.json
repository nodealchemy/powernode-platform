  "scripts": {
    "start": "VITE_APP_VERSION=$(cat VERSION) vite",
    "dev": "VITE_APP_VERSION=$(cat VERSION) vite --host 0.0.0.0",
    "build": "VITE_APP_VERSION=$(cat VERSION) vite build",
    "build:full": "VITE_APP_VERSION=$(cat VERSION) tsc && VITE_APP_VERSION=$(cat VERSION) vite build",
    "build:verbose": "VITE_APP_VERSION=$(cat VERSION) vite build --debug",
    "refresh-proxy": "node scripts/refresh-proxy-cache.js",
    "test": "NODE_OPTIONS='--no-deprecation --experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--no-deprecation --experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--no-deprecation --experimental-vm-modules' jest --coverage",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:check": "eslint --inspect-config",
    "typecheck": "tsc --noEmit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:parallel": "cypress-split",
    "cypress:parallel:2": "npm run cypress:parallel -- --split 2",
    "cypress:parallel:4": "npm run cypress:parallel -- --split 4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@types/d3-dispatch": "3.0.6"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
