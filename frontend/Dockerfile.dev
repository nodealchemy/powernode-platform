# Development Dockerfile for React frontend
# Node 24 to satisfy package.json engines (>=24.9.0).
FROM node:24-alpine

# tini is included in node:alpine images as /sbin/tini
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy the application
COPY . .

# Expose port
EXPOSE 3001

ENTRYPOINT ["tini", "--"]
CMD ["npm", "start"]
