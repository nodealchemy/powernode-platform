# Worker Authentication Token
# This is generated automatically by the Rails application
# Run: rails db:seed to generate system worker token
WORKER_TOKEN=generate_via_rails_db_seed

# ===================================================================
# MCP (Model Context Protocol)
# ===================================================================
# The stdio MCP deadline is NOT an environment variable (IMP-f010c9fc7051).
# A synchronous call (/api/v1/mcp/execute_stdio) carries its own
# `timeout_seconds` from the server's SiteSetting `mcp.stdio.timeout_seconds`
# and is refused above McpSecurityService::MAX_STDIO_TIMEOUT_SECONDS (60).
# The async jobs use McpSecurityService::DEFAULT_STDIO_TIMEOUT_SECONDS (30).

# IMP-a50680fd53d8 (MCP isolation Phase 1 T2) — every stdio MCP child
# runs inside a transient `systemd-run` sandbox (DynamicUser,
# ProtectSystem=strict, ProtectHome, network deny-by-default, resource
# limits) unless this is "off". DynamicUser needs the SYSTEM manager —
# this worker must be running as root (or hold an equivalent polkit
# grant, not yet built — see IMP-94977647c24c) for sandboxing to work at
# all; there is no non-root default path today.
#
#   required (default) — refuse to spawn UNSANDBOXED at all; fails
#     closed with McpSecurityService::SandboxUnavailableError if this
#     worker isn't root or systemd-run isn't on PATH.
#   available — sandbox when possible; otherwise spawn UNSANDBOXED after
#     a WARN log naming exactly why. Never silent.
#   off — never sandbox. Only meant for local dev without root/systemd,
#     or a host where systemd-run genuinely isn't available. The test
#     suite sets this itself (worker/spec/spec_helper.rb) — do not rely
#     on this file's default to make specs pass; that would make a
#     production install's failure mode ALSO the test suite's default.
#
# MCP_STDIO_SANDBOX_MODE=required

# Resource limits applied to every SANDBOXED stdio MCP child (ignored
# when MCP_STDIO_SANDBOX_MODE=off). Each is a systemd unit property value
# verbatim (MemoryMax/TasksMax/CPUQuota syntax) — see systemd.resource-
# control(5). Defaults shown are McpSecurityService's own
# DEFAULT_SANDBOX_* constants.
# MCP_STDIO_SANDBOX_MEMORY_MAX=512M
# MCP_STDIO_SANDBOX_TASKS_MAX=64
# MCP_STDIO_SANDBOX_CPU_QUOTA=200%

# Directory holding the per-spawn EnvironmentFile (root-owned, mode 0700,
# created on demand) used to pass server-supplied env vars into a
# sandboxed child WITHOUT them appearing in `systemctl show -p
# Environment` (verified: --setenv values are readable there by ANY
# local user, even for a unit started by root; an EnvironmentFile's path
# shows there but its content never does). Change this only if
# /run/powernode isn't writable/tmpfs-backed on a given host — the test
# suite overrides it to a tmp dir it actually owns (see
# worker/spec/spec_helper.rb), since /run/powernode is root-owned 0755.
# MCP_STDIO_SANDBOX_ENV_DIR=/run/powernode/mcp-stdio-env
