# Worker Authentication Token
# This is generated automatically by the Rails application
# Run: rails db:seed to generate system worker token
WORKER_TOKEN=generate_via_rails_db_seed

# ===================================================================
# MCP (Model Context Protocol)
# ===================================================================
# Deadline, in seconds, for a single stdio MCP child process spawned by
# McpSecurityService#spawn_stdio (also read by the server's
# Mcp::SecurityService). Past this, the child's whole process group is
# killed and #spawn_stdio raises McpSecurityService::StdioTimeoutError.
# Defaults to DEFAULT_STDIO_TIMEOUT_SECONDS (30) when unset.
# MCP_STDIO_TIMEOUT_SECONDS=30
