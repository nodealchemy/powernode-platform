# Worker Authentication Token
# This is generated automatically by the Rails application
# Run: rails db:seed to generate system worker token
WORKER_TOKEN=generate_via_rails_db_seed

# ===================================================================
# MCP (Model Context Protocol)
# ===================================================================
# Deadline, in seconds, for a single stdio MCP child process spawned by
# McpSecurityService#spawn_stdio — this is the ONLY app that still
# spawns stdio MCP children (IMP-abda86fb39be moved that here from the
# server). Past this, the child's whole process group is killed and
# #spawn_stdio raises McpSecurityService::StdioTimeoutError.
#
# MUST be set to the SAME value as the server's own
# MCP_STDIO_TIMEOUT_SECONDS (server/.env.example) — the server's
# Mcp::WorkerStdioClient sizes its HTTP read_timeout around THIS
# deadline plus grace plus margin; a mismatch means the server can give
# up on a still-running (and correctly-behaving) worker child.
#
# Defaults to DEFAULT_STDIO_TIMEOUT_SECONDS (30) when unset.
# MCP_STDIO_TIMEOUT_SECONDS=30
