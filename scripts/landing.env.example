# landing.env.example — template for the deployment-local configuration read by
#   scripts/verify-hub-deploy.sh, scripts/land.sh, scripts/wt.sh, scripts/pre-critic-gate.sh
#
# Copy to scripts/local/landing.env (gitignored) and fill in YOUR deployment's values, or point
# POWERNODE_LOCAL_CONFIG at another file. Variables already set in the environment win over the
# file. POWERNODE_LOCAL_CONFIG=none loads no file at all. Every value below is a PLACEHOLDER:
# hostnames, addresses, VM ids, unit names and endpoints must never be written to a tracked file.

# ---- verify-hub-deploy.sh ---------------------------------------------------------------
# A command that reads a bash script on STDIN, runs it on the hub with enough privilege to read
# the rails unit state, and prints that script's stdout. Keep it a plain remote-shell invocation.
HUB_EXEC_CMD='ssh -o BatchMode=yes <operator>@<hub-host> sudo -n bash -s'
# When the transport wraps stdout in the hypervisor guest-agent JSON envelope ({"out-data": ...})
# set this to qga-json (and make HUB_EXEC_CMD deliver the script to the guest); otherwise leave unset.
# HUB_EXEC_UNWRAP=qga-json
# Exact rails unit. Leave unset to discover it on the hub from `powernode-*-rails.service`.
# HUB_RAILS_UNIT=<rails-unit-name>.service
# URL of the health endpoint AS SEEN FROM THE HUB.
HUB_UP_URL='http://127.0.0.1:<rails-port>/up'
# Commands run ON THE HUB that print the deployed core / extension commit sha. How a hub records
# its deployed revision is deployment-specific, so it is configuration, not code.
HUB_CORE_SHA_CMD='cat <path-to-deployed-core-revision-file>'
HUB_EXT_SHA_CMD='cat <path-to-deployed-extension-revision-file>'
# HUB_PASSWD_MIN_LINES=10
# HUB_EXEC_TIMEOUT=90

# ---- land.sh ----------------------------------------------------------------------------
# Git remote names to push to, and the target branch (defaults: origin / develop).
# LAND_CORE_REMOTE=origin
# LAND_EXT_REMOTE=origin
# LAND_TARGET_BRANCH=develop
# Extension submodule path the core gitlink points at (default: the only public submodule in
# .gitmodules, when there is exactly one).
# LAND_EXT_PATH=extensions/<name>
# MCP endpoint reachable from this machine (the local proxy or the API), and the bearer token
# variable NAME to read it from. The token itself is never written to a file the scripts create.
LAND_MCP_URL='http://127.0.0.1:<proxy-port>'
# LAND_MCP_TOKEN_ENV=POWERNODE_MCP_TOKEN
# Environments promoted in order after a successful build (default: staging ops).
# LAND_PROMOTE_ENVS='staging ops'
# Platform repository ids or full names, needed only for `land.sh --merge-via mcp`.
# LAND_CORE_REPOSITORY=<owner>/<core-repo>
# LAND_EXT_REPOSITORY=<owner>/<extension-repo>
# owner/repo the build diff is taken against (default: derived from the core remote's URL).
# LAND_SOURCE_REPO=<owner>/<core-repo>
# Tool-name prefix the endpoint expects on verbs (default platform.); empty for bare names.
# LAND_MCP_TOOL_PREFIX=platform.
# Build batch polling: seconds between polls, and the overall ceiling.
# LAND_POLL_INTERVAL=20
# LAND_POLL_TIMEOUT=2400

# ---- wt.sh ------------------------------------------------------------------------------
# Where worktrees are created (default: ~/worktrees).
# WT_ROOT=$HOME/worktrees
# Lane ledger (gitignored, flock-protected). Default: <main checkout>/scripts/local/worktree-lanes.
# WT_LANE_LEDGER=
# Highest redis lane handed out (default 5, matching prepare-worktree.sh) and how long an
# unfinished create keeps its reserved lane (seconds, default 900).
# WT_MAX_LANE=5
# WT_RESERVATION_TTL=900
# Command that drops a lane's test database on `wt.sh remove` (it receives TEST_DB_NAME and
# TEST_ENV_NUMBER). Default: `dropdb --if-exists powernode_test<suffix>` with the ambient PG* settings.
# WT_PROTECTED_DBS=
# WT_DROPDB_CMD=
