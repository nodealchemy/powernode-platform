[Unit]
Description=Powernode Backend API (instance %i)
Documentation=https://github.com/powernode/platform
After=postgresql.service redis.service network.target
Wants=postgresql.service redis.service
PartOf=powernode.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/powernode/powernode.conf
EnvironmentFile=/etc/powernode/backend-%i.conf

WorkingDirectory=/opt/powernode/server
ExecStart=/opt/powernode/scripts/systemd/powernode-backend.sh
ExecReload=/bin/kill -SIGUSR2 $MAINPID

Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s

SyslogIdentifier=powernode-backend-%i

# fw-cfg blob staging for LocalQemuProvider's CloudSeed. Without this the
# provider falls back to /tmp/powernode-fwcfg-<uid>/ with a Permission denied
# warning. RuntimeDirectory= creates /run/powernode-fwcfg owned by User= on
# start. RuntimeDirectoryPreserve=yes keeps the dir's contents across unit
# restarts — without it, a backend restart wipes all staged fw-cfg files
# and any libvirt domain that had been provisioned but not yet started
# would fail to start ("can't load /var/run/powernode-fwcfg/...: No such
# file or directory"). The dir still goes away on host shutdown.
RuntimeDirectory=powernode-fwcfg
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# OCI blob cache for System::OciBlobProxyService (module artifact pulls).
# StateDirectory= creates /var/lib/powernode/oci-cache owned by User= before
# the service starts — without it, the app can't mkdir under the root-owned
# /var/lib/powernode parent (EACCES), and every module-blob pull 500s.
# Path matches the service's CACHE_ROOT default (POWERNODE_OCI_CACHE_DIR).
StateDirectory=powernode/oci-cache
StateDirectoryMode=0755

# Security hardening (injected by installer in production mode)
# NoNewPrivileges=true
# ProtectSystem=strict
# PrivateTmp=true
# ReadWritePaths=/opt/powernode/server/tmp /opt/powernode/server/log /opt/powernode/server/storage

[Install]
WantedBy=powernode.target
