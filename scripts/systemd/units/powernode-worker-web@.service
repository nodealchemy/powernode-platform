[Unit]
Description=Powernode Worker HTTP API: embeddings/LLM/jobs + Sidekiq UI (instance %i)
Documentation=https://github.com/powernode/platform
After=powernode-worker@%i.service
# Intentionally NOT BindsTo=powernode-worker@ — this is the Worker HTTP API
# (embeddings, LLM proxy, job endpoints on :4567), and it must survive worker@
# restarts/stops. BindsTo propagated worker@'s stop but not its start, so a
# restart of the Sidekiq job worker silently orphaned the embedding API and
# broke embeddings/learnings/RAG platform-wide. Kept alive instead by
# PartOf=powernode.target + WantedBy + Restart=on-failure; After= preserves
# boot ordering only.
PartOf=powernode.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/powernode/powernode.conf
EnvironmentFile=/etc/powernode/worker-web-%i.conf

WorkingDirectory=/opt/powernode/worker
ExecStart=/opt/powernode/scripts/systemd/powernode-worker-web.sh

Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=15s

SyslogIdentifier=powernode-worker-web-%i

# Security hardening (injected by installer in production mode)
# NoNewPrivileges=true
# ProtectSystem=strict
# PrivateTmp=true
# ReadWritePaths=/opt/powernode/worker/tmp /opt/powernode/worker/log

[Install]
WantedBy=powernode.target
